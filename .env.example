APP_ENV=development
# 本机开发凭据。这里不用 "change-me" 之类的占位符，是因为 scripts/ 下的默认值、
# scripts/init-test-postgres.ps1 与 CI 全都按 audit_app / audit_migrator 密码
# `admin` 建库。照抄 .env.example 即可直接连上，不必再回头改密码。
# 仅适用于回环地址上的本机开发库；生产环境必须改掉并通过密码管理系统分发。
DATABASE_URL=postgresql://audit_app:admin@localhost:5432/audit_network
# Integration tests never default to DATABASE_URL. Initialize this database
# explicitly with scripts/init-test-postgres.ps1 before running pytest.
AUDIT_NETWORK_TEST_DATABASE_URL=postgresql://audit_app:admin@localhost:5432/audit_network_test
AUDIT_NETWORK_MIGRATOR_DATABASE_URL=postgresql://audit_migrator:admin@localhost:5432/audit_network_test
APP_TENANT_ID=
APP_USER_ID=
OBJECT_STORE_ROOT=.data/objects
EMBEDDING_DIMENSION=1024
# 分段日志 spool 的位置。留空即默认 .data/isolated/logs；需要把 spool 放到
# 其它卷时覆盖它（测试也用它把自己的 spool 与运行实例隔离）。
# AUDIT_NETWORK_SPOOL_ROOT=D:/audit-spool
# 插件可读的外部数据根目录（apps/api/main.py 的 Settings.plugin_read_roots）。
# 默认留空 = 不启用，插件读不到任何外部路径。启用时用分号分隔登记选定的子目录，
# 不要指向整个卷。
# AUDIT_PLUGIN_READ_ROOTS=D:/audit-samples
#
# 注：这里原先写的是 EXTERNAL_DATA_ROOT，但全仓没有任何代码读取它，真正的开关
# 是上面的 AUDIT_PLUGIN_READ_ROOTS。旧行已移除，避免照抄一个无效配置。

# --- 统一 AI 接入（packages/ai）---------------------------------------------
# 画布 AI 助手、AI 组网规划、知识库向量化共用这一份配置。桌面端左侧「系统 →
# AI 设置」页面会把这里的值写回本机 .env 并立即生效（无需重启）。
#
# 解析顺序（先命中先用）：AI_* → 旧的 OPENAI_COMPAT_* / OLLAMA_* → 内置默认。
# 因此现有部署不改也能继续跑；下面的 AI_* 只在填写后才覆盖旧变量。
# 本文件不含任何真实密钥；.env 已在 .gitignore 中，不会进版本库。
AI_PROVIDER=openai_compat
AI_BASE_URL=https://api.commandcode.ai/provider/v1
AI_MODEL=meituan/LongCat-2.0:free
# 密钥只写在这里，不要提交；未设置时远程调用 fail-closed 拒绝。
AI_API_KEY=
AI_TIMEOUT=600
# AI_MAX_TOKENS=            # 留空使用服务端默认
# AI_REASONING_EFFORT=      # 如 low / medium / high
# AI_PROXY=http://127.0.0.1:7890
# 仅本地 Ollama 生效：
AI_NUM_CTX=65536

# 向量 / Embedding 通道（默认本地 Ollama，维度须与数据库向量列一致）
AI_EMBED_PROVIDER=ollama
AI_EMBED_BASE_URL=http://127.0.0.1:11434
AI_EMBED_MODEL=qwen3-embedding:0.6b
AI_EMBED_TIMEOUT=120
AI_EMBED_DIMENSIONS=1024

# --- 可选本地能力 ------------------------------------------------------------
# MinerU 富媒体解析（PDF/图片 → Markdown）。默认留空 = 该能力显示为
# “等待本地运行时”，不影响启动，也不影响其它功能。填成你自己那套 MinerU
# 虚拟环境里的控制台脚本即可启用（只读取、不写入该目录）。
# MINERU_EXECUTABLE=D:/MinerU/.venv/Scripts/mineru.exe
