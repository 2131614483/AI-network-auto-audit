{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/mission-spec.schema.json",
  "title": "MissionSpec",
  "description": "由用户或调度器提交给控制平面的长期任务规范。",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "tenant_id", "project_id", "domain", "title", "objective", "autonomy_mode", "acceptance_criteria"],
  "properties": {
    "mission_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "domain": {"type": "string", "enum": ["audit", "quant", "aiops", "knowledge", "platform"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "objective": {"type": "string", "minLength": 1, "maxLength": 20000},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "autonomy_mode": {"type": "string", "enum": ["ASSISTED", "AUTO_SAFE", "AUTO_APPROVAL", "AUTO_FULL"]},
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_cost": {"type": "number", "minimum": 0},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "input_artifacts": {"type": "array", "items": {"$ref": "artifact-ref.schema.json"}},
    "constraints": {"type": "object", "additionalProperties": true},
    "requested_by": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
