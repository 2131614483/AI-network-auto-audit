{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/graph-candidate-set.schema.json",
  "title": "GraphCandidateSet",
  "description": "从文档抽取的实体与关系候选集合：每条候选带来源定位、置信度与证据；候选先进入 shadow ChangeSet，未经规则/人工批准不进入活跃图谱。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "document_sha256", "source_uri", "summary", "entity_candidates", "relation_candidates"],
  "properties": {
    "contract_id": {"const": "graph-candidate-set"},
    "contract_version": {"const": "1.0.0"},
    "document_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source_uri": {"type": "string", "minLength": 1, "maxLength": 2048},
    "language": {"type": "string", "enum": ["zh", "en", "auto"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "relations"],
      "properties": {
        "entities": {"type": "integer", "minimum": 0},
        "relations": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    },
    "entity_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "entity_type", "name", "span", "evidence"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1, "maxLength": 255},
          "entity_type": {"type": "string", "enum": ["organization", "document", "person", "generic"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 512},
          "span": {"type": "string", "minLength": 1, "maxLength": 512},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "relation_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "source_id", "target_id", "relation_type", "span", "evidence"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1, "maxLength": 255},
          "source_id": {"type": "string", "minLength": 1, "maxLength": 255},
          "target_id": {"type": "string", "minLength": 1, "maxLength": 255},
          "relation_type": {"type": "string", "enum": ["related_party", "controls", "invests_in", "transacts_with", "cites", "part_of", "generic"]},
          "span": {"type": "string", "minLength": 1, "maxLength": 512},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "object", "additionalProperties": true}
        }
      }
    }
  }
}
