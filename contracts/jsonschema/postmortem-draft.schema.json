{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/postmortem-draft.schema.json",
  "title": "PostmortemDraft",
  "description": "复盘草稿（aiops.postmortem-draft 输出）：基于已确认 incident-proposal@1 与可选 recovery-verification@1 引用确定性生成可追溯复盘草稿。草稿永不自动发布：实际发布必须人工审批；插件本身无网络、不写基础设施。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "postmortem_id", "status", "incident_refs", "title", "overview", "timeline_steps", "root_cause_candidates", "action_items", "verification_refs", "summary", "signature", "constraints", "provenance"],
  "properties": {
    "contract_id": {"const": "postmortem-draft"},
    "contract_version": {"const": "1.0.0"},
    "postmortem_id": {"type": "string", "pattern": "^[A-Fa-f0-9]{16}$"},
    "status": {"const": "draft"},
    "incident_refs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "overview": {"type": "string", "minLength": 1, "maxLength": 2048},
    "timeline_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "sequence", "reference"],
        "properties": {
          "step": {"type": "string", "minLength": 1, "maxLength": 256},
          "sequence": {"type": "integer", "minimum": 1},
          "reference": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "root_cause_candidates": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "action_items": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "owner", "priority"],
        "properties": {
          "action": {"type": "string", "minLength": 1, "maxLength": 512},
          "owner": {"type": "string", "minLength": 1, "maxLength": 64},
          "priority": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "verification_refs": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "evidence_refs": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incidents", "severity", "verification_refs", "truncated"],
      "properties": {
        "incidents": {"type": "integer", "minimum": 1},
        "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
        "verification_refs": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drafted_by", "published", "publisher"],
      "properties": {
        "drafted_by": {"const": "aiops.postmortem-draft@0.1.0"},
        "published": {"const": false},
        "publisher": {"type": "null"}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_auto_publish", "requires_human_approval", "immutable_source"],
      "properties": {
        "no_auto_publish": {"const": true},
        "requires_human_approval": {"const": true},
        "immutable_source": {"const": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_sha256", "verification_sha256", "plugin", "draft_time"],
      "properties": {
        "incident_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "verification_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "plugin": {"const": "aiops.postmortem-draft@0.1.0"},
        "draft_time": {"type": "string"}
      }
    }
  }
}