{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/graph-extraction.schema.json",
  "title": "GraphExtractionCandidate",
  "description": "受 ChangeSet 治理的自动图谱抽取候选。抽取器只产出候选，经校验/批准/Release 后才写入活图；任意连边与未登记空间由契约拒绝。",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "source_uri", "space_key", "node_key", "node_type", "label", "property_source", "confidence"],
  "properties": {
    "document_id": {"type": "string", "format": "uuid"},
    "source_uri": {"type": "string"},
    "space_key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "node_key": {"type": "string", "minLength": 1},
    "node_type": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "properties": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "property_source": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "relation_type": {"$ref": "#/$defs/relation_type"},
    "target_node_key": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "relation_type": {
      "enum": ["regulated_by", "owns", "part_of", "depends_on", "references", "evidence_for"]
    }
  }
}