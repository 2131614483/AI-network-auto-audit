{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/workflow.schema.json",
  "title": "WorkflowDefinition",
  "description": "可持久化工作流的类型化 DAG；执行器必须保留版本和幂等语义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "tenant_id", "key", "version", "input_schema", "output_schema", "nodes", "edges"],
  "properties": {
    "workflow_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "input_schema": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string"}}, "additionalProperties": true},
    "output_schema": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string"}}, "additionalProperties": true},
    "nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "checksum": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  },
  "$defs": {
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "kind"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "kind": {"type": "string", "enum": ["task", "agent", "approval", "condition", "parallel", "join", "compensation"]},
        "capability": {"type": "string"},
        "plugin": {"type": "string"},
        "input_mapping": {"type": "object", "additionalProperties": {"type": "string"}},
        "retry": {"type": "object", "additionalProperties": false, "properties": {"max_attempts": {"type": "integer", "minimum": 1}, "backoff": {"type": "string", "enum": ["none", "fixed", "exponential"]}}},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "compensation_node": {"type": "string"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string"}, "to": {"type": "string"},
        "condition": {"type": "string", "maxLength": 2000}
      }
    }
  }
}
