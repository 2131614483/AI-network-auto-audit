{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/renderer-descriptor.schema.json",
  "title": "RendererDescriptor",
  "description": "声明式 UI 使用的稳定渲染器或受控扩展渲染器。",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "protocol_version", "sandbox_mode"],
  "properties": {
    "key": {"type": "string", "enum": ["markdown", "data-table", "form", "chart", "graph", "card", "json", "web-component"]},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "protocol_version": {"type": "string", "minLength": 1},
    "sandbox_mode": {"type": "string", "enum": ["core", "iframe", "isolated_origin"]},
    "bundle_uri": {"type": "string", "format": "uri"},
    "bundle_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "supported_schema_range": {"type": "string", "minLength": 1},
    "trust_level": {"type": "string", "enum": ["core", "signed", "untrusted"]}
  }
}
