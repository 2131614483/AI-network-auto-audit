{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/plugin-topology-release.schema.json",
  "title": "PluginTopologyRelease",
  "description": "可复现的插件拓扑目录发布锁；只冻结蓝图和集群引用，不包含任何插件代码或执行授权。",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_id", "version", "status", "checksum_sha256", "cluster_ids", "blueprint_ids", "created_at"],
  "properties": {
    "release_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 160},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"type": "string", "enum": ["draft", "published", "retired"]},
    "checksum_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "parent_release_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "cluster_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "blueprint_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_catalog_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
