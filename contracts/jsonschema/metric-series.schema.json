{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/metric-series.schema.json",
  "title": "MetricSeries",
  "description": "不可变指标序列工件：带点时间的单指标样本序列，用于 AIOps 基线/观测对比；序列只读，不触发任何修复动作。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "series_id", "metric", "unit", "window_minutes", "points"],
  "properties": {
    "contract_id": {"const": "metric-series"},
    "contract_version": {"const": "1.0.0"},
    "series_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "metric": {"type": "string", "minLength": 1, "maxLength": 128},
    "unit": {"type": "string", "minLength": 1, "maxLength": 64},
    "window_minutes": {"type": "integer", "minimum": 1, "maximum": 10080},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "value"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "value": {"type": "number"}
        }
      }
    }
  }
}
