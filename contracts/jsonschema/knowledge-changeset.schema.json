{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/knowledge-changeset.schema.json",
  "title": "KnowledgeChangeSet",
  "description": "知识摄入、冲突处理、人工编辑或 Agent 提案形成的不可变知识变更集。",
  "type": "object",
  "additionalProperties": false,
  "required": ["changeset_id", "tenant_id", "project_id", "source_type", "operations", "created_by", "created_at"],
  "properties": {
    "changeset_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "source_type": {"type": "string", "enum": ["ingest", "agent", "human", "conflict_resolution", "migration", "rollback"]},
    "source_ref": {"type": "string", "maxLength": 2048},
    "base_release_id": {"type": "string", "format": "uuid"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "validation": {"type": "object", "additionalProperties": false, "properties": {"status": {"type": "string", "enum": ["pending", "passed", "failed"]}, "errors": {"type": "array", "items": {"type": "string"}}}},
    "created_by": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "checksum": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  },
  "$defs": {
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "target_type", "target_key"],
      "properties": {
        "op": {"type": "string", "enum": ["upsert_node", "upsert_edge", "retire_node", "retire_edge", "add_alias", "remove_alias", "create_claim", "resolve_conflict"]},
        "target_type": {"type": "string", "enum": ["node", "edge", "alias", "claim", "conflict"]},
        "target_key": {"type": "string", "minLength": 1, "maxLength": 512},
        "graph_space_id": {"type": "string", "format": "uuid"},
        "payload": {"type": "object", "additionalProperties": true},
        "evidence_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_row_version": {"type": "integer", "minimum": 0}
      }
    }
  }
}
