{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/topology-plan.schema.json",
  "title": "TopologyPlanRequest",
  "description": "插件拓扑 plan 服务请求载荷。输出为 plugin-routing-plan（只允许 plan_only）；本载荷必须携带意图、预算与 L2 能力需求，禁止任何执行语义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "idempotency_key", "mode", "capability_requirements", "budget"],
  "properties": {
    "intent": {"type": "string", "minLength": 1, "maxLength": 2000},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 255},
    "trace_id": {"type": "string", "format": "uuid"},
    "mode": {"const": "plan_only"},
    "capability_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_candidates", "max_chain_length", "max_latency_ms"],
      "properties": {
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_chain_length": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_latency_ms": {"type": "integer", "minimum": 1, "maximum": 120000}
      }
    },
    "release_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "version", "checksum_sha256"],
      "properties": {
        "release_id": {"type": "string"},
        "version": {"type": "string"},
        "checksum_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "planner_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"}
  }
}
