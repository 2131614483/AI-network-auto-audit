{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/graph-query-budget.schema.json",
  "title": "GraphQueryBudget",
  "description": "图谱检索的强制预算，所有图查询必须携带并由服务层执行。",
  "type": "object",
  "additionalProperties": false,
  "required": ["max_graphs", "max_hops", "max_frontier", "max_nodes", "max_edges", "max_bridge_hops", "max_latency_ms", "min_confidence"],
  "properties": {
    "max_graphs": {"type": "integer", "minimum": 1, "maximum": 100},
    "max_hops": {"type": "integer", "minimum": 0, "maximum": 20},
    "max_frontier": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_nodes": {"type": "integer", "minimum": 1, "maximum": 100000},
    "max_edges": {"type": "integer", "minimum": 0, "maximum": 500000},
    "max_bridge_hops": {"type": "integer", "minimum": 0, "maximum": 5},
    "max_latency_ms": {"type": "integer", "minimum": 1, "maximum": 120000},
    "min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "allowed_relation_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_graph_space_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "allowed_graph_space_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}}
  }
}
