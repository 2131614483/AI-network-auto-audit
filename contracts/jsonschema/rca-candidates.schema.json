{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/rca-candidates.schema.json",
  "title": "RcaCandidates",
  "description": "根因候选排序输出：每条候选带排名、根因文本、图节点引用、分数、置信度与支撑事故；候选不等同于已确认根因，不触发修复。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "incident_set_sha256", "topology_sha256", "summary", "candidates"],
  "properties": {
    "contract_id": {"const": "rca-candidates"},
    "contract_version": {"const": "1.0.0"},
    "incident_set_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "topology_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "window_minutes": {"type": "integer", "minimum": 1, "maximum": 10080},
    "max_hops": {"type": "integer", "minimum": 1, "maximum": 3},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incidents_processed", "nodes_considered", "candidate_count", "truncated"],
      "properties": {
        "incidents_processed": {"type": "integer", "minimum": 0},
        "nodes_considered": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "candidate_id", "root_cause", "node_ref", "score", "confidence", "support_count", "supporting_incidents", "evidence"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "candidate_id": {"type": "string", "minLength": 1, "maxLength": 255},
          "root_cause": {"type": "string", "minLength": 1, "maxLength": 512},
          "node_ref": {"type": "string", "minLength": 1, "maxLength": 255},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "support_count": {"type": "integer", "minimum": 1},
          "supporting_incidents": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
          "evidence": {"type": "object", "additionalProperties": true}
        }
      }
    }
  }
}
