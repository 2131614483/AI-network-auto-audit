{
  "$defs": {
    "GoalRequirement": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "capabilities": {
              "minItems": 1
            }
          },
          "required": [
            "capabilities"
          ]
        },
        {
          "properties": {
            "output_ports": {
              "minItems": 1
            }
          },
          "required": [
            "output_ports"
          ]
        }
      ],
      "properties": {
        "key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Key",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Capabilities",
          "type": "array"
        },
        "output_ports": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Output Ports",
          "type": "array"
        }
      },
      "required": [
        "key",
        "description"
      ],
      "title": "GoalRequirement",
      "type": "object"
    },
    "PlanningBudget": {
      "additionalProperties": false,
      "properties": {
        "max_rounds": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Rounds",
          "type": "integer"
        },
        "max_queries": {
          "default": 18,
          "maximum": 48,
          "minimum": 3,
          "title": "Max Queries",
          "type": "integer"
        },
        "max_model_calls": {
          "default": 8,
          "maximum": 16,
          "minimum": 2,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_nodes": {
          "default": 16,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Nodes",
          "type": "integer"
        },
        "max_evidence_chars": {
          "default": 24000,
          "maximum": 64000,
          "minimum": 1000,
          "title": "Max Evidence Chars",
          "type": "integer"
        },
        "max_seconds": {
          "default": 180,
          "maximum": 600,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        }
      },
      "title": "PlanningBudget",
      "type": "object"
    },
    "PlanningInput": {
      "additionalProperties": false,
      "properties": {
        "port_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Port Id",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "port_id",
        "schema_ref",
        "artifact_id"
      ],
      "title": "PlanningInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mode": {
      "const": "plan_only",
      "default": "plan_only",
      "title": "Mode",
      "type": "string"
    },
    "goal": {
      "maxLength": 2000,
      "minLength": 4,
      "title": "Goal",
      "type": "string"
    },
    "domain": {
      "default": "audit",
      "enum": [
        "audit",
        "aiops",
        "knowledge",
        "quant"
      ],
      "title": "Domain",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/GoalRequirement"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/PlanningInput"
      },
      "maxItems": 32,
      "title": "Inputs",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/PlanningBudget"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "goal",
    "requirements",
    "idempotency_key",
    "reason"
  ],
  "title": "PlanningRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/collaborative-planning.schema.json"
}
