{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/finding-draft.schema.json",
  "title": "FindingDraft",
  "description": "由日记账异常候选（可结合调查计划草稿）构建的审计发现草稿：每条 Finding 携带确定性 Claim 与证据 Ref，状态恒为 proposed。草稿不确认任何 Finding、不代替独立 QA 或人工复核；由审计域服务在策略裁决后写入审计候选收件箱。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "anomaly_set_sha256", "draft_id", "period", "rule_pack_sha256", "findings", "summary"],
  "properties": {
    "contract_id": {"const": "finding-draft"},
    "contract_version": {"const": "1.0.0"},
    "anomaly_set_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "draft_id": {"type": "string", "pattern": "^[A-Fa-f0-9]{16}$"},
    "period": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "rule_pack_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "findings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "title", "severity", "rule_key", "status", "claims", "counter_hypotheses"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^[A-Fa-f0-9]{16}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 512},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "rule_key": {"type": "string", "enum": ["invalid_date", "outlier_amount", "negative_amount", "round_amount", "duplicate_row", "missing_amount"]},
          "status": {"const": "proposed"},
          "row_refs": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
          "evidence_refs": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
          "claims": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim_id", "statement", "basis", "severity"],
              "properties": {
                "claim_id": {"type": "string", "pattern": "^[A-Fa-f0-9]{16}$"},
                "statement": {"type": "string", "minLength": 1, "maxLength": 2048},
                "basis": {"type": "string", "enum": ["anomaly", "gap", "counter"]},
                "rule_key": {"type": "string", "enum": ["invalid_date", "outlier_amount", "negative_amount", "round_amount", "duplicate_row", "missing_amount"]},
                "row_ref": {"type": "string", "minLength": 1, "maxLength": 512},
                "evidence_refs": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "severity": {"type": "string", "enum": ["low", "medium", "high"]}
              }
            }
          },
          "counter_hypotheses": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hypothesis_id", "hypothesis", "verify_with"],
              "properties": {
                "hypothesis_id": {"type": "string", "pattern": "^[A-Fa-f0-9]{16}$"},
                "hypothesis": {"type": "string", "minLength": 1, "maxLength": 1024},
                "verify_with": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
              }
            }
          },
          "proposed_action": {"type": "string", "enum": ["investigate", "confirm", "escalate"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["covered_candidates", "findings", "claims", "evidence_refs", "truncated"],
      "properties": {
        "covered_candidates": {"type": "integer", "minimum": 0},
        "findings": {"type": "integer", "minimum": 0},
        "claims": {"type": "integer", "minimum": 0},
        "evidence_refs": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "unknown_rule_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}