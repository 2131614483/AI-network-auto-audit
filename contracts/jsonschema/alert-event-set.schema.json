{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/alert-event-set.schema.json",
  "title": "AlertEventSet",
  "description": "告警事件集工件引用：不可变 JSON 事件数组引用、关联时间窗、分组键与候选预算；事件内容不嵌入控制面消息。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "artifact", "window_minutes", "max_candidates"],
  "properties": {
    "contract_id": {"const": "alert-event-set"},
    "contract_version": {"const": "1.0.0"},
    "artifact": {"$ref": "artifact-ref.schema.json"},
    "window_minutes": {"type": "integer", "minimum": 1, "maximum": 10080},
    "max_candidates": {"type": "integer", "minimum": 1, "maximum": 1000},
    "grouping_keys": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 255}
    }
  }
}
