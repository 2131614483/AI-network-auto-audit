{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/topology-release.schema.json",
  "title": "TopologyRelease",
  "description": "插件拓扑目录发布/回滚服务载荷。发布必须携带冻结目录校验和（SHA256）与本次覆盖的集群/蓝图键；发布后不可原地覆盖，回滚必须显式引用既有版本。",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "idempotency_key"],
  "properties": {
    "action": {"type": "string", "enum": ["publish", "rollback"]},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 255},
    "trace_id": {"type": "string", "format": "uuid"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "catalog_checksum": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "cluster_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 120}},
    "blueprint_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 160}},
    "rollback_from_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "reason": {"type": "string", "maxLength": 1000},
    "created_by": {"type": "string", "format": "uuid"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "publish"}}, "required": ["action"]},
      "then": {
        "required": ["version", "catalog_checksum", "cluster_keys", "blueprint_keys"]
      }
    },
    {
      "if": {"properties": {"action": {"const": "rollback"}}, "required": ["action"]},
      "then": {
        "required": ["rollback_from_version"]
      }
    }
  ]
}
