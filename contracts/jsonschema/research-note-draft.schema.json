{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit.local/contracts/research-note-draft.schema.json",
  "title": "ResearchNoteDraft",
  "description": "量化研究结论草稿（quant.research-note-draft 输出）：基于已确认 experiment-evaluation@1 引用确定性生成可追溯研究结论草稿。草稿永不自动发布：发布必须人工审批；不含订单、不更新生产模型。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "note_id", "status", "evaluation_refs", "strategy", "title", "overview", "findings", "recommendations", "summary", "signature", "constraints", "provenance"],
  "properties": {
    "contract_id": {"const": "research-note-draft"},
    "contract_version": {"const": "1.0.0"},
    "note_id": {"type": "string", "pattern": "^[A-Fa-f0-9]{16}$"},
    "status": {"const": "draft"},
    "evaluation_refs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version"],
      "properties": {
        "key": {"type": "string", "minLength": 1, "maxLength": 255},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "overview": {"type": "string", "minLength": 1, "maxLength": 2048},
    "findings": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "recommendations": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluations", "recommendation", "truncated"],
      "properties": {
        "evaluations": {"type": "integer", "minimum": 1},
        "recommendation": {"type": "string", "enum": ["promote", "hold", "reject"]},
        "truncated": {"type": "boolean"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drafted_by", "published", "publisher"],
      "properties": {
        "drafted_by": {"const": "quant.research-note-draft@0.1.0"},
        "published": {"const": false},
        "publisher": {"type": "null"}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_auto_publish", "no_order_generation", "requires_human_approval", "immutable_source"],
      "properties": {
        "no_auto_publish": {"const": true},
        "no_order_generation": {"const": true},
        "requires_human_approval": {"const": true},
        "immutable_source": {"const": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_sha256", "plugin", "draft_time"],
      "properties": {
        "evaluation_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "plugin": {"const": "quant.research-note-draft@0.1.0"},
        "draft_time": {"type": "string"}
      }
    }
  }
}