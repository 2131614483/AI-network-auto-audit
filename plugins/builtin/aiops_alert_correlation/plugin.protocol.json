{
  "protocol_version": "1.0.0",
  "id": "aiops.alert-correlation",
  "version": "0.1.0",
  "name": "AIOps 告警关联",
  "description": "对告警事件集 JSON 工件引用运行确定性时间窗关联，产出事件候选集合；候选不等同于已确认事件，不写入事故库。",
  "kind": "analysis",
  "domains": ["aiops"],
  "lifecycle": "contract_only",
  "compatibility": {"host_protocol": ">=1.0.0 <2.0.0", "adapters": ["python"], "fallback_behavior": "human_review"},
  "capabilities": [
    {
      "id": "aiops.alert.correlate",
      "summary": "按时间窗与分组键把告警事件聚类为事件候选，带严重度、计数、置信度与证据，输出 incident-candidate-set@1。",
      "side_effects": "read_only",
      "idempotency": "alert_set_sha256 + window_minutes + grouping_keys",
      "inputs": [
        {
          "contract_id": "alert-event-set",
          "version": "1.0.0",
          "format": "artifact_ref",
          "delivery": "reference",
          "classification": "internal",
          "schema_ref": "alert-event-set.schema.json"
        }
      ],
      "outputs": [
        {
          "contract_id": "incident-candidate-set",
          "version": "1.0.0",
          "format": "json",
          "delivery": "request_response",
          "classification": "internal",
          "schema_ref": "incident-candidate-set.schema.json"
        }
      ]
    }
  ],
  "governance": {
    "default_data_classification": "internal",
    "permissions": {"data_read": ["aiops.alerts"], "data_write": [], "network": "none", "secret_refs": []},
    "policy": {"gateway_required": true, "approval_required": false, "evidence_required": true}
  },
  "resources": {"cpu": 1, "memory_mb": 256, "gpu": "none", "timeout_seconds": 300},
  "observability": {"trace_required": true, "emits": ["structured_log", "artifact_ref", "audit_event"], "health": "declared_only"},
  "provenance": {"source_refs": ["docs/审计组网插件规划-v1.md#7.1", "docs/审计组网插件规划-v1.md#8", "docs/插件开发与接入标准-UPP-v1.0.md"]},
  "ui": {"mode": "none"}
}
