{
 "id": "audit.report.report-data-check",
 "version": "0.1.0",
 "name": "报告数据校验（契约声明）",
 "runtime": "python",
 "entrypoint": "plugins.builtin.audit_report_report_data_check.runtime:handle",
 "capabilities": [
  "audit.report.report-data-check"
 ],
 "inputs": {
  "capability": "audit.report.report-data-check",
  "schema": "report-draft.schema.json",
  "content_type": "application/json"
 },
 "outputs": {
  "capability": "audit.report.report-data-check",
  "schema": "dataset-validation.schema.json",
  "content_type": "application/json"
 },
 "side_effects": "read_only",
 "idempotency": "input_sha256 + capability_version",
 "permissions": {
  "data_read": [
   "audit.report.report-data-check.read"
  ],
  "data_write": [],
  "network": "none",
  "secrets": []
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": false,
  "timeout_seconds": 300
 },
 "data_classification": "audit_confidential",
 "evidence": {
  "preserve_inputs": true,
  "code_hash_required": true
 },
 "tests": {
  "contract": "tests/contract/test_audit_report_report_data_check_contract.py",
  "golden": "tests/unit/test_audit_report_report_data_check_runtime.py"
 }
}