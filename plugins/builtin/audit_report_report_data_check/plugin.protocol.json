{
 "protocol_version": "1.0.0",
 "id": "audit.report.report-data-check",
 "version": "0.1.0",
 "name": "报告数据校验",
 "description": "校验报告中数据/口径一致；上游报告初稿，调用数据质量校验。",
 "kind": "analysis",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.report.report-data-check",
   "summary": "报告数据校验：校验报告中数据/口径一致；上游报告初稿，调用数据质量校验。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "report-draft-input",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "report-draft.schema.json",
     "max_bytes": 16777216
    }
   ],
   "outputs": [
    {
     "contract_id": "report-check-report",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "dataset-validation.schema.json",
     "max_bytes": 4194304
    }
   ],
   "invokes": [
    "audit.foundation.quality-check"
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [
    "audit.report.report-data-check.read"
   ],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#84",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_report_report_data_check/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}
