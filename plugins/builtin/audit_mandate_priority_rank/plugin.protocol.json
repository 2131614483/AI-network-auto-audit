{
 "protocol_version": "1.0.0",
 "id": "audit.mandate.priority-rank",
 "version": "0.1.0",
 "name": "项目优先级排序",
 "description": "基于风险/重要性/资源匹配度排序；上游项目库，调用统一指标计算权重（⇢）。",
 "kind": "analysis",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.mandate.priority-rank",
   "summary": "项目优先级排序：基于风险/重要性/资源匹配度排序；上游项目库，调用统一指标计算权重（⇢）。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "project-snapshot",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "dataset-validation.schema.json",
     "max_bytes": 4194304
    }
   ],
   "outputs": [
    {
     "contract_id": "priority-order",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "metric-series.schema.json",
     "max_bytes": 16777216
    }
   ],
   "invokes": [
    "audit.foundation.metric-compute"
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [
    "audit.mandate.priority-rank.read"
   ],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#24",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_mandate_priority_rank/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}
