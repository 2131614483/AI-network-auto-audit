{
  "id": "aiops.postmortem-draft",
  "version": "0.1.0",
  "name": "AIOps 复盘草稿（受审批输出，只读）",
  "runtime": "python",
  "entrypoint": "plugins.builtin.aiops_postmortem_draft.runtime:handle",
  "capabilities": ["aiops.postmortem.draft"],
  "inputs": {
    "capability": "aiops.postmortem.draft",
    "schema": "incident-proposal.schema.json",
    "content_type": "application/json"
  },
  "outputs": {
    "capability": "aiops.postmortem.draft",
    "schema": "postmortem-draft@1.0.0",
    "content_type": "application/json"
  },
  "side_effects": "read_only",
  "idempotency": "incident_sha256_and_verification_sha256",
  "permissions": {
    "data_read": ["aiops.incident_proposals", "aiops.recovery_verifications"],
    "data_write": [],
    "network": "none",
    "secrets": []
  },
  "resources": {"cpu": 1, "memory_mb": 256, "gpu": false, "timeout_seconds": 120},
  "data_classification": "internal",
  "evidence": {"preserve_inputs": true, "code_hash_required": true},
  "tests": {
    "contract": "tests/contract/test_aiops_postmortem_draft_contract.py",
    "golden": "tests/unit/test_aiops_postmortem_draft_runtime.py"
  }
}