{
  "protocol_version": "1.0.0",
  "id": "aiops.ticket-draft",
  "version": "0.1.0",
  "name": "AIOps 工单草稿",
  "description": "基于已确认 incident-proposal 事件生成可追溯外部工单草稿的受审批输出契约；草稿永不自动发送，实际发送必须满足目标系统白名单与人工审批，不覆盖历史工单。",
  "kind": "analysis",
  "domains": [
    "aiops",
    "compliance"
  ],
  "lifecycle": "contract_only",
  "compatibility": {
    "host_protocol": ">=1.0.0 <2.0.0",
    "adapters": [
      "python",
      "node",
      "http",
      "mcp",
      "container"
    ],
    "optional_features": [
      "evidence-chain-v1"
    ],
    "fallback_behavior": "human_review"
  },
  "capabilities": [
    {
      "id": "aiops.ticket.draft",
      "summary": "对不可变已确认 incident-proposal 集合按固定目标系统生成确定性、可追溯的外部工单草稿；草稿永不自动发送，需目标系统白名单与人工审批。",
      "side_effects": "read_only",
      "idempotency": "incident_proposal_sha256_and_target_system",
      "inputs": [
        {
          "contract_id": "incident-proposal",
          "version": "1.0.0",
          "format": "json",
          "delivery": "artifact_ref",
          "classification": "internal",
          "schema_ref": "incident-proposal.schema.json"
        }
      ],
      "outputs": [
        {
          "contract_id": "ticket-draft",
          "version": "1.0.0",
          "format": "json",
          "delivery": "artifact_ref",
          "classification": "internal",
          "schema_ref": "ticket-draft.schema.json"
        }
      ],
      "policy": {
        "approval_required": true,
        "evidence_required": true
      }
    }
  ],
  "governance": {
    "default_data_classification": "internal",
    "permissions": {
      "data_read": [
        "aiops.incident_proposals"
      ],
      "data_write": [],
      "network": "none",
      "secret_refs": []
    },
    "policy": {
      "gateway_required": true,
      "approval_required": true,
      "evidence_required": true
    }
  },
  "resources": {
    "cpu": 1,
    "memory_mb": 256,
    "gpu": "none",
    "timeout_seconds": 120
  },
  "observability": {
    "trace_required": true,
    "emits": [
      "structured_log",
      "metric",
      "audit_event"
    ],
    "health": "declared_only"
  },
  "provenance": {
    "source_refs": [
      "docs/plugin-protocol.md",
      "docs/审计组网插件规划-v1.md#r3"
    ]
  },
  "ui": {
    "mode": "declarative",
    "contribution_schema": "ui-contribution.schema.json"
  }
}
