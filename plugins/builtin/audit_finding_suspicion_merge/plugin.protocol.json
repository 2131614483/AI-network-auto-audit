{
  "protocol_version": "1.0.0",
  "id": "audit.finding.suspicion-merge",
  "version": "0.1.0",
  "name": "审计疑点汇总",
  "description": "汇总全流程疑点去重分类；上游现场疑点标记与取证，下游输出至问题核实。",
  "kind": "analysis",
  "domains": [
    "audit",
    "compliance"
  ],
  "lifecycle": "verified",
  "compatibility": {
    "host_protocol": ">=1.0.0 <2.0.0",
    "adapters": [
      "python"
    ],
    "fallback_behavior": "human_review"
  },
  "capabilities": [
    {
      "id": "audit.finding.suspicion-merge",
      "summary": "审计疑点汇总：汇总全流程疑点去重分类；上游现场疑点标记与取证，下游输出至问题核实。",
      "side_effects": "read_only",
      "idempotency": "input_sha256 + capability_version",
      "inputs": [
        {
          "contract_id": "suspicion-set",
          "version": "1.0.0",
          "format": "artifact_ref",
          "delivery": "reference",
          "classification": "audit_confidential",
          "schema_ref": "anomaly-candidates.schema.json",
          "max_bytes": 67108864,
          "cardinality": "many"
        },
        {
          "contract_id": "photo-evidence",
          "version": "1.0.0",
          "format": "artifact_ref",
          "delivery": "reference",
          "classification": "audit_confidential",
          "schema_ref": "artifact-ref.schema.json",
          "max_bytes": 268435456
        }
      ],
      "outputs": [
        {
          "contract_id": "merged-suspicion",
          "version": "1.0.0",
          "format": "json",
          "delivery": "request_response",
          "classification": "audit_confidential",
          "schema_ref": "anomaly-candidates.schema.json",
          "max_bytes": 67108864
        }
      ]
    }
  ],
  "governance": {
    "default_data_classification": "audit_confidential",
    "permissions": {
      "data_read": [
        "audit.finding.suspicion-merge.read"
      ],
      "data_write": [],
      "network": "none",
      "secret_refs": []
    },
    "policy": {
      "gateway_required": true,
      "approval_required": false,
      "evidence_required": true
    }
  },
  "resources": {
    "cpu": 1,
    "memory_mb": 256,
    "gpu": "none",
    "timeout_seconds": 300
  },
  "observability": {
    "trace_required": true,
    "emits": [
      "structured_log",
      "artifact_ref",
      "audit_event"
    ],
    "health": "declared_only"
  },
  "provenance": {
    "source_refs": [
      "docs/audit-plugin-network-100.md#73",
      "docs/插件开发与接入标准-UPP-v1.0.md",
      "plugins/builtin/audit_finding_suspicion_merge/runtime.py"
    ]
  },
  "ui": {
    "mode": "none"
  }
}
