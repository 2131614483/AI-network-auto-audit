{
 "protocol_version": "1.0.0",
 "id": "audit.field.evidence-photo",
 "version": "0.1.0",
 "name": "现场取证拍照上传",
 "description": "上传取证照片并关联底稿；调用 OCR 识别，输出至证据管理。",
 "kind": "ingestion",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.field.evidence-photo",
   "summary": "现场取证拍照上传：上传取证照片并关联底稿；调用 OCR 识别，输出至证据管理。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "photo-input",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "artifact-ref.schema.json",
     "max_bytes": 268435456
    }
   ],
   "outputs": [
    {
     "contract_id": "photo-evidence",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "artifact-ref.schema.json",
     "max_bytes": 268435456
    }
   ],
   "invokes": [
    "audit.foundation.ocr-extract"
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [
    "audit.field.evidence-photo.read"
   ],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#59",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_field_evidence_photo/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}
