{
 "protocol_version": "1.0.0",
 "id": "audit.field.voucher-drilldown",
 "version": "0.1.0",
 "name": "凭证穿透查询",
 "description": "从报表直达明细账、凭证原始单据；上游财务数据，调用多源数据采集。",
 "kind": "retrieval",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.field.voucher-drilldown",
   "summary": "凭证穿透查询：从报表直达明细账、凭证原始单据；上游财务数据，调用多源数据采集。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "clean-finance-set",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "ledger-artifact-ref.schema.json",
     "max_bytes": 268435456
    }
   ],
   "outputs": [
    {
     "contract_id": "voucher-chain",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "ledger-artifact-ref.schema.json",
     "max_bytes": 268435456
    }
   ],
   "invokes": [
    "audit.foundation.multi-source-collect"
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [
    "audit.field.voucher-drilldown.read"
   ],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#51",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_field_voucher_drilldown/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}
