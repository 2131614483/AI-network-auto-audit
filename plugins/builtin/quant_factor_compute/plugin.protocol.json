{
  "protocol_version": "1.0.0",
  "id": "quant.factor-compute",
  "version": "0.1.0",
  "name": "量化因子计算",
  "description": "对已验证的市场快照 CSV 工件引用运行确定性因子计算，产出带因子包哈希与逐因子统计的工件引用；因子仅用于只读分析。",
  "kind": "analysis",
  "domains": ["quant"],
  "lifecycle": "contract_only",
  "compatibility": {"host_protocol": ">=1.0.0 <2.0.0", "adapters": ["python"], "fallback_behavior": "human_review"},
  "capabilities": [
    {
      "id": "quant.factor.compute",
      "summary": "在已验证快照上计算收益、波动率、动量、Z 分数、回撤与成交量 Z 分数因子，输出 factor-artifact-ref@1。",
      "side_effects": "read_only",
      "idempotency": "snapshot_sha256 + factors + lookback",
      "inputs": [
        {
          "contract_id": "factor-input",
          "version": "1.0.0",
          "format": "artifact_ref",
          "delivery": "reference",
          "classification": "restricted",
          "schema_ref": "factor-input.schema.json"
        }
      ],
      "outputs": [
        {
          "contract_id": "factor-artifact-ref",
          "version": "1.0.0",
          "format": "json",
          "delivery": "request_response",
          "classification": "restricted",
          "schema_ref": "factor-artifact-ref.schema.json"
        }
      ]
    }
  ],
  "governance": {
    "default_data_classification": "restricted",
    "permissions": {"data_read": ["quant.backtests"], "data_write": [], "network": "none", "secret_refs": []},
    "policy": {"gateway_required": true, "approval_required": false, "evidence_required": true}
  },
  "resources": {"cpu": 1, "memory_mb": 512, "gpu": "none", "timeout_seconds": 300},
  "observability": {"trace_required": true, "emits": ["structured_log", "artifact_ref", "audit_event"], "health": "declared_only"},
  "provenance": {"source_refs": ["docs/审计组网插件规划-v1.md#6.2", "docs/审计组网插件规划-v1.md#8", "docs/插件开发与接入标准-UPP-v1.0.md"]},
  "ui": {"mode": "none"}
}
