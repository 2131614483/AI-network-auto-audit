   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#96",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_govern_effect_evaluate/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
