{
  "id": "aiops.rca-ranker",
  "version": "0.1.0",
  "name": "AIOps 根因候选排序（本地只读）",
  "runtime": "python",
  "entrypoint": "plugins.builtin.aiops_rca_ranker.runtime:handle",
  "capabilities": ["aiops.rca.rank"],
  "inputs": {
    "capability": "aiops.rca.rank",
    "schema": "rca-input.schema.json",
    "content_type": "application/json"
  },
  "outputs": {
    "capability": "aiops.rca.rank",
    "schema": "rca-candidates@1.0.0",
    "content_type": "application/json"
  },
  "side_effects": "read_only",
  "idempotency": "incident_set_sha256 + topology_sha256 + window_minutes + max_hops",
  "permissions": {
    "data_read": ["aiops.alerts", "aiops.topology"],
    "data_write": [],
    "network": "none",
    "secrets": []
  },
  "resources": {"cpu": 1, "memory_mb": 256, "gpu": false, "timeout_seconds": 300},
  "data_classification": "internal",
  "evidence": {"preserve_inputs": true, "code_hash_required": true},
  "tests": {
    "contract": "tests/contract/test_aiops_rca_ranker_contract.py",
    "golden": "tests/unit/test_aiops_rca_ranker_runtime.py"
  }
}
