 "kind": "analysis",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.mandate.proposal-score",
   "summary": "立项评审打分：按预设维度对立项申请评分排序；上游立项申报，调用工作流引擎驱动评审（⇢）。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
