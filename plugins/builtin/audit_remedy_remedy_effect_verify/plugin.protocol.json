     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "evidence-lineage.schema.json",
     "max_bytes": 16777216
    }
   ],
   "outputs": [
    {
     "contract_id": "remedy-verdict",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "dataset-validation.schema.json",
     "max_bytes": 4194304
