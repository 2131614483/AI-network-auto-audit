{
 "protocol_version": "1.0.0",
 "id": "audit.govern.issue-trend-analysis",
 "version": "0.1.0",
 "name": "问题趋势分析",
 "description": "分析多期问题趋势/高发领域；上游历史问题库，调用可视化分析。",
 "kind": "visualization",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.govern.issue-trend-analysis",
   "summary": "问题趋势分析：分析多期问题趋势/高发领域；上游历史问题库，调用可视化分析。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "history-issue-set",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "finding-draft.schema.json",
     "max_bytes": 16777216
    }
   ],
   "outputs": [
    {
     "contract_id": "trend-report",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "metric-series.schema.json",
     "max_bytes": 16777216
    }
   ],
   "invokes": [
    "audit.foundation.viz-analysis"
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [
    "audit.govern.issue-trend-analysis.read"
   ],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#98",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_govern_issue_trend_analysis/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}
