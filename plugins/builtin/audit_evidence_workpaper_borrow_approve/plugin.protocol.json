{
 "protocol_version": "1.0.0",
 "id": "audit.evidence.workpaper-borrow-approve",
 "version": "0.1.0",
 "name": "底稿借阅审批",
 "description": "管理底稿的借阅、复制申请与审批；调用工作流、权限管控插件。",
 "kind": "analysis",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.evidence.workpaper-borrow-approve",
   "summary": "管理底稿的借阅、复制申请与审批；调用工作流、权限管控插件。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "borrow-request",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "document-content.schema.json",
     "max_bytes": 268435456
    }
   ],
   "outputs": [
    {
     "contract_id": "borrow-status",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "document-content.schema.json",
     "max_bytes": 268435456
    }
   ],
   "invokes": [
    "audit.foundation.permission-control"
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_evidence_workpaper_borrow_approve/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}
