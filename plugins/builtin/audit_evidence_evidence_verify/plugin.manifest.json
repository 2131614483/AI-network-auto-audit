{
 "id": "audit.evidence.evidence-verify",
 "version": "0.1.0",
 "name": "证据真实性校验（契约声明）",
 "runtime": "python",
 "entrypoint": "plugins.builtin.audit_evidence_evidence_verify.runtime:handle",
 "capabilities": [
  "audit.evidence.evidence-verify"
 ],
 "inputs": {
  "capability": "audit.evidence.evidence-verify",
  "schema": "evidence-lineage.schema.json",
  "content_type": "application/json"
 },
 "outputs": {
  "capability": "audit.evidence.evidence-verify",
  "schema": "dataset-validation.schema.json",
  "content_type": "application/json"
 },
 "side_effects": "read_only",
 "idempotency": "input_sha256 + capability_version",
 "permissions": {
  "data_read": [
   "audit.evidence.evidence-verify.read"
  ],
  "data_write": [],
  "network": "none",
  "secrets": []
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": false,
  "timeout_seconds": 300
 },
 "data_classification": "audit_confidential",
 "evidence": {
  "preserve_inputs": true,
  "code_hash_required": true
 },
 "tests": {
  "contract": "tests/contract/test_audit_evidence_evidence_verify_contract.py",
  "golden": "tests/unit/test_audit_evidence_evidence_verify_runtime.py"
 }
}