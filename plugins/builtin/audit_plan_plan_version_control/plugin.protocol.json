{
 "protocol_version": "1.0.0",
 "id": "audit.plan.plan-version-control",
 "version": "0.1.0",
 "name": "计划版本管控",
 "description": "管理计划与方案多版本变更；上游计划变更申请，调用工作流引擎。",
 "kind": "governance",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.plan.plan-version-control",
   "summary": "计划版本管控：管理计划与方案多版本变更；上游计划变更申请，调用工作流引擎。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "plan-change",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "document-content.schema.json",
     "max_bytes": 67108864
    }
   ],
   "outputs": [
    {
     "contract_id": "plan-version",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "workflow.schema.json",
     "max_bytes": 4194304
    }
   ],
   "invokes": [
    "audit.foundation.workflow-engine"
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [
    "audit.plan.plan-version-control.read"
   ],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#48",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_plan_plan_version_control/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}
