{
 "protocol_version": "1.0.0",
 "id": "audit.finding.issue-amount-compute",
 "version": "0.1.0",
 "name": "问题金额计算",
 "description": "自动核算问题金额/税款/损失；上游问题核实与财务数据。",
 "kind": "analysis",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.finding.issue-amount-compute",
   "summary": "问题金额计算：自动核算问题金额/税款/损失；上游问题核实与财务数据。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "issue-verify-input",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "finding-draft.schema.json",
     "max_bytes": 16777216
    },
    {
     "contract_id": "clean-finance-set",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "ledger-artifact-ref.schema.json",
     "max_bytes": 268435456
    }
   ],
   "outputs": [
    {
     "contract_id": "issue-amount",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "finding-draft.schema.json",
     "max_bytes": 16777216
    }
   ],
   "invokes": [
    "audit.foundation.finance-clean"
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [
    "audit.finding.issue-amount-compute.read"
   ],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#76",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit-finding-issue-amount-compute/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}
