   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#2",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit-foundation-finance-clean/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}