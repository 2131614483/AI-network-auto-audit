{
 "protocol_version": "1.0.0",
 "id": "audit.remedy.remedy-dispatch",
 "version": "0.1.0",
 "name": "整改任务派单",
 "description": "问题拆解为整改任务派发责任主体；上游正式报告问题清单，调用工作流引擎。",
 "kind": "workflow",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.remedy.remedy-dispatch",
   "summary": "整改任务派单：问题拆解为整改任务派发责任主体；上游正式报告问题清单，调用工作流引擎。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "final-issue-set",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "finding-draft.schema.json",
     "max_bytes": 16777216
    }
   ],
   "outputs": [
    {
     "contract_id": "remedy-task",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "workflow.schema.json",
     "max_bytes": 4194304
    }
   ],
   "invokes": [
    "audit.foundation.workflow-engine"
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [
    "audit.remedy.remedy-dispatch.read"
   ],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#88",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_remedy_remedy_dispatch/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}
