{
 "protocol_version": "1.0.0",
 "id": "audit.report.report-multi-review",
 "version": "0.1.0",
 "name": "报告多级审核",
 "description": "驱动报告多级审批与修改；调用工作流引擎，同步管理版本。",
 "kind": "workflow",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.report.report-multi-review",
   "summary": "报告多级审核：驱动报告多级审批与修改；调用工作流引擎，同步管理版本。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "report-check-report",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "dataset-validation.schema.json",
     "max_bytes": 4194304
    }
   ],
   "outputs": [
    {
     "contract_id": "report-approved",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "report-draft.schema.json",
     "max_bytes": 16777216
    }
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [
    "audit.report.report-multi-review.read"
   ],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#85",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_report_report_multi_review/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}