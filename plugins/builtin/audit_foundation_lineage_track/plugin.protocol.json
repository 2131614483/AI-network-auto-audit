{
 "protocol_version": "1.0.0",
 "id": "audit.foundation.lineage-track",
 "version": "0.1.0",
 "name": "数据血缘追踪",
 "description": "记录数据采集到应用全链路流转；被证据真实性校验、问题溯源、底稿复核调用（⇢）。",
 "kind": "graph",
 "domains": [
  "audit",
  "compliance"
 ],
 "lifecycle": "verified",
 "compatibility": {
  "host_protocol": ">=1.0.0 <2.0.0",
  "adapters": [
   "python"
  ],
  "fallback_behavior": "human_review"
 },
 "capabilities": [
  {
   "id": "audit.foundation.lineage-track",
   "summary": "数据血缘追踪：记录数据采集到应用全链路流转；被证据真实性校验、问题溯源、底稿复核调用（⇢）。",
   "side_effects": "read_only",
   "idempotency": "input_sha256 + capability_version",
   "inputs": [
    {
     "contract_id": "lineage-query",
     "version": "1.0.0",
     "format": "artifact_ref",
     "delivery": "reference",
     "classification": "audit_confidential",
     "schema_ref": "artifact-ref.schema.json",
     "max_bytes": 268435456
    }
   ],
   "outputs": [
    {
     "contract_id": "lineage-graph",
     "version": "1.0.0",
     "format": "json",
     "delivery": "request_response",
     "classification": "audit_confidential",
     "schema_ref": "evidence-lineage.schema.json",
     "max_bytes": 16777216
    }
   ]
  }
 ],
 "governance": {
  "default_data_classification": "audit_confidential",
  "permissions": {
   "data_read": [
    "audit.foundation.lineage-track.read"
   ],
   "data_write": [],
   "network": "none",
   "secret_refs": []
  },
  "policy": {
   "gateway_required": true,
   "approval_required": false,
   "evidence_required": true
  }
 },
 "resources": {
  "cpu": 1,
  "memory_mb": 256,
  "gpu": "none",
  "timeout_seconds": 300
 },
 "observability": {
  "trace_required": true,
  "emits": [
   "structured_log",
   "artifact_ref",
   "audit_event"
  ],
  "health": "declared_only"
 },
 "provenance": {
  "source_refs": [
   "docs/audit-plugin-network-100.md#5",
   "docs/插件开发与接入标准-UPP-v1.0.md",
   "plugins/builtin/audit_foundation_lineage_track/runtime.py"
  ]
 },
 "ui": {
  "mode": "none"
 }
}